msgstr "&Pregledaj..."

#: kmuddy/dialogs/dlgdumpbuffer.cpp:65
#, kde-format
msgid "&Dump format:"
msgstr "F&ormat popisa:"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:67
#, kde-format
msgid "HTML"
msgstr "HTML"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:68
#, kde-format
msgid "Plain text"
msgstr "običan tekst"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:69
#, kde-format
msgid "Text with ANSI colors"
msgstr "tekst sa ANSI bojama"

#: kmuddy/dialogs/dlgeditprofile.cpp:38 kmuddy/dialogs/dlgeditprofile.cpp:180
#: kmuddy/dialogs/dlgeditprofile.cpp:185
#, kde-format
msgid "Edit profile"
msgstr "Uređivanje profila"

#: kmuddy/dialogs/dlgeditprofile.cpp:44
#, kde-format
msgid "Profile &name:"
msgstr "&Ime profila:"

#: kmuddy/dialogs/dlgeditprofile.cpp:46
#, kde-format
msgid ""
"Enter profile name here. You can enter any name, but it must be <b>unique</"
"b>."
msgstr ""
"Ovdje unesite ime profila. Možete unijeti bilo koje ime, ali mora biti "
"<b>jedinstveno</b>."

#: kmuddy/dialogs/dlgeditprofile.cpp:47
#, kde-format
msgid "&Server:"
msgstr "&Server:"

#: kmuddy/dialogs/dlgeditprofile.cpp:49
#, kde-format
msgid "Enter address of the server where your MUD is running."
msgstr "Unesite adresu servera na kome radi vaš MUD."

#: kmuddy/dialogs/dlgeditprofile.cpp:50 kmuddy/dialogs/dlgquickconnect.cpp:40
#, kde-format
msgid "&Port:"
msgstr "P&ort:"

#: kmuddy/dialogs/dlgeditprofile.cpp:54
#, kde-format
msgid "Enter port on which your MUD is running (usually some 4-digit number)."
msgstr "Unesite port na kome radi vaš MUD (obično neki četvorocifreni broj)."

#: kmuddy/dialogs/dlgeditprofile.cpp:55
#, kde-format
msgid "&Login name:"
msgstr "&Prijavno ime:"

#: kmuddy/dialogs/dlgeditprofile.cpp:57
#, kde-format
msgid ""
"Enter your login name on the MUD here.<p><i>This setting is optional.</i>"
msgstr ""
"Ovdje unesite svoje prijavno ime na MUD‑u.<p><i>Ova postavka nije obavezna.</"
"i></p>"

#: kmuddy/dialogs/dlgeditprofile.cpp:58
#, kde-format
msgid "Pass&word:"
msgstr "&Lozinka:"

#: kmuddy/dialogs/dlgeditprofile.cpp:61
#, kde-format
msgid "Enter your password on the MUD here.<p><i>This setting is optional.</i>"
msgstr ""
"Ovdje unesite svoju lozinku na MUD‑u.<p><i>Ova postavka nije obavezna.</i></"
"p>"

#: kmuddy/dialogs/dlgeditprofile.cpp:62
#, kde-format
msgctxt "Commands sent after connection is established"
msgid "&Connect sequence"
msgstr "&Niz pri povezivanju"

#: kmuddy/dialogs/dlgeditprofile.cpp:66
#, kde-format
msgid ""
"Commands to be sent to the MUD after logging in.<br><b>$name</b> expands to "
"username.<br><b>$password</b> expands to your password.<p><b>Important:</b> "
"these commands are sent exactly as you type them, with leading/trailing "
"spaces removed. No aliases, no macros, no speed-walk. Also note that empty "
"lines will also be sent, including the very last line."
msgstr ""
"Naredbe koje se šalju na MUD poslije prijavljivanja.<br/><b>$name</b> se "
"razvija u korisničko ime.<br/><b>$password</b> se razvija u vašu lozinku."
"<p><b>Važno:</b> ove naredbe se šalju tačno onako kako ih otkucate, bez "
"početnih i pratećih razmaka. Bez alijasa, makroa i brzog hoda. Takođe, šalju "
"se i prazni redovi, uključujući i sasvim posljednji red.</p>"

#: kmuddy/dialogs/dlgeditprofile.cpp:180
#, kde-format
msgid "Profile name cannot be empty."
msgstr "Ime profila ne može biti prazno."

#: kmuddy/dialogs/dlgeditprofile.cpp:185
#, kde-format
msgid "Profile name cannot contain '/' character."
msgstr "Ime profila ne može sadržati znak „/“."

