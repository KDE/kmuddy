#: kmuddy/dialogs/dlgappsettings.cpp:748 kmuddy/dialogs/dlgappsettings.cpp:757
#: plugins/mapper/dialogs/dlgmaptextpropertiesbase.ui:102
#, kde-format
msgid "Italic"
msgstr "Kurzivno"

#: kmuddy/dialogs/dlgconnect.cpp:40
#, kde-format
msgid "Connect"
msgstr "Povezivanje"

#: kmuddy/dialogs/dlgconnect.cpp:57
#, kde-format
msgid ""
"This list shows currently defined profiles.<p><b>Profiles</b> allow you to "
"speed up connecting to your MUD, as well as to use more advanced features "
"like <i>aliases</i> or <i>triggers</i>."
msgstr ""
"Ovaj spisak prikazuje trenutno definisane profile.<p><b>Profili</b> vam "
"omogućavaju da se brže povezujete na MUD, kao i da koristite naprednije "
"mogućnosti kao što su <i>alijasi</i> ili <i>okidači</i>.</p>"

#: kmuddy/dialogs/dlgconnect.cpp:64
#, kde-format
msgid "&New profile"
msgstr "&Novi profil"

#: kmuddy/dialogs/dlgconnect.cpp:65
#, kde-format
msgid "&Modify profile"
msgstr "&Izmijeni profil"

#: kmuddy/dialogs/dlgconnect.cpp:66
#, kde-format
msgid "&Delete profile"
msgstr "&Obriši profil"

#: kmuddy/dialogs/dlgconnect.cpp:67
#, kde-format
msgid "&Duplicate profile"
msgstr "&Dupliraj profil"

#: kmuddy/dialogs/dlgconnect.cpp:73
#, kde-format
msgid "Do not &send login sequence"
msgstr "Ne &šalji niz prijavljivanja"

#: kmuddy/dialogs/dlgconnect.cpp:74
#, kde-format
msgid ""
"Login sequence won't be sent for this connect. Useful when you're creating a "
"new character and you want to use QuickConnect for some reason."
msgstr ""
"Niz prijavljivanja neće biti poslat za ovo povezivanje. Korisno kad pravite "
"novog lika i iz nekog razloga želite da koristite brzo povezivanje."

#: kmuddy/dialogs/dlgconnect.cpp:79
#, kde-format
msgid "&Offline editing"
msgstr "&Uređivanje van veze"

#: kmuddy/dialogs/dlgconnect.cpp:80
#, kde-format
msgid "This allows offline editing of profiles."
msgstr "Ovo omogućava uređivanje profila van veze."

#: kmuddy/dialogs/dlgconnect.cpp:86 kmuddy/dialogs/dlgquickconnect.cpp:55
#, kde-format
msgid "&Connect"
msgstr "&Poveži se"

#: kmuddy/dialogs/dlgconnect.cpp:87 kmuddy/dialogs/dlgquickconnect.cpp:56
#, kde-format
msgid "Establishes connection with specified parameters."
msgstr "Uspostavlja vezu sa zadatim parametrima."

#: kmuddy/dialogs/dlgconnect.cpp:89
#, kde-format
msgid "C&lose"
msgstr "&Zatvori"

#: kmuddy/dialogs/dlgconnect.cpp:90
#, kde-format
msgid "Closes this dialog box without connecting."
msgstr "Zatvara ovaj dijalog bez povezivanja."

#: kmuddy/dialogs/dlgconnect.cpp:235
#, kde-format
msgid ""
"This profile cannot be deleted, because you have a connection open using "
"this profile."
msgstr ""
"Ovaj profil ne može da se obriše, jer imate otvorenu vezu koja ga koristi."

#: kmuddy/dialogs/dlgconnect.cpp:235
#, kde-format
msgid "Unable to delete"
msgstr "Ne mogu da obrišem"

#: kmuddy/dialogs/dlgconnect.cpp:239
#, kde-format
msgid "Do you really want to delete profile %1?"
msgstr "Želite li zaista da obrišete profil %1?"

#: kmuddy/dialogs/dlgconnect.cpp:239
#, kde-format
msgid "Delete profile"
msgstr "Brisanje profila"

#: kmuddy/dialogs/dlgconnect.cpp:255
#, kde-format
msgid "Duplicate Profile"
msgstr "Dupliranje profila"

#: kmuddy/dialogs/dlgconnect.cpp:255
#, kde-format
msgid "Please enter name for the duplicated profile"
msgstr "Unesite ime za duplirani profil"

#: kmuddy/dialogs/dlgconnect.cpp:257
#, kde-format
msgid ""
"There was an error trying to duplicate the profile. Please ensure that you "
"have write access to the profile directory."
msgstr ""
"Došlo je do greške pri pokušaju dupliranja profila. Provjerite da li imate "
"dozvolu za pisanje u fasciklu profila."

#: kmuddy/dialogs/dlgconnect.cpp:257
#, kde-format
msgid "Unable to duplicate"
msgstr "Ne mogu da dupliram"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:38
#, kde-format
msgid "Dump output buffer"
msgstr "Popis izlaznog bafera"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:44
#, kde-format
msgid "&Start at current position"
msgstr "Počni od &tekućeg položaja"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:45
#, kde-format
msgid ""
"When this is enabled, only the part of history buffer from currently "
"displayed part up to the end of buffer will be dumped. Otherwise entire "
"buffer will be dumped (default)."
msgstr ""
"Kad je ovo uključeno, popisaće se samo dio bafera istorijata od trenutno "
"prikazanog dijela do kraja bafera. Inače će se popisati cio bafer "
"(podrazumijevano)."

#: kmuddy/dialogs/dlgdumpbuffer.cpp:52 kmuddy/dialogs/dlgtranscript.cpp:86
#, kde-format
msgid "&File:"
msgstr "&Fajl:"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:55 kmuddy/dialogs/dlgtranscript.cpp:89
#, kde-format
