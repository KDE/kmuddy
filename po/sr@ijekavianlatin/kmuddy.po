#, kde-format
msgid "Keygrabber"
msgstr "Hvatač tastera"

#: kmuddy/dialogs/dlggrabkey.cpp:37
#, kde-format
msgid "Press the desired shortcut..."
msgstr "Pritisnite željenu prečicu..."

