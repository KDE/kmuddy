msgstr "Postavke programa"

#: kmuddy/dialogs/dlgappsettings.cpp:84
#, kde-format
msgid "Window"
msgstr "Prozor"

#: kmuddy/dialogs/dlgappsettings.cpp:87
#, kde-format
msgid "Output area"
msgstr "Izlazna oblast"

#: kmuddy/dialogs/dlgappsettings.cpp:90
#, kde-format
