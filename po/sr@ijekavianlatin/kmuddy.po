msgstr "&Ime profila"

#: kmuddy/dialogs/dlgimportexportprofile.cpp:54
#, kde-format
msgid "&Import from"
msgstr "&Uvezi iz"

#: kmuddy/dialogs/dlgimportexportprofile.cpp:55
#, kde-format
