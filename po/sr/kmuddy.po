msgstr "Излазни прозори"

#: kmuddy/ctriggereditor.cpp:478
#, kde-format
msgid "&Gag output in main window"
msgstr "&Пригуши излаз у главном прозору"

#: kmuddy/ctriggereditor.cpp:479
#, kde-format
msgid ""
"This will cause output sent to a separate window not to be displayed in main "
"KMuddy session window"
msgstr ""
"Овим се излаз послат у засебан прозор неће приказивати у главном прозору "
"сесије KMuddy‑ја"

