#: kmuddy/dialogs/dlgappsettings.cpp:84
#, kde-format
msgid "Window"
msgstr "Прозор"

#: kmuddy/dialogs/dlgappsettings.cpp:87
#, kde-format
msgid "Output area"
msgstr "Излазна област"

#: kmuddy/dialogs/dlgappsettings.cpp:90
#, kde-format
msgid "Font"
msgstr "Фонт"

#: kmuddy/dialogs/dlgappsettings.cpp:93
#, kde-format
