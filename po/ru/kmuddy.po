#: kmuddy/dialogs/dlgmultiline.cpp:45
#, kde-format
msgid ""
"Enter commands that are to be sent to the MUD. Each line represents one "
"command."
msgstr ""
"Введите команды, которые должны отправляться в MUD. Каждая строка — одна "
"команда."

#: kmuddy/dialogs/dlgmultiline.cpp:56
#, kde-format
